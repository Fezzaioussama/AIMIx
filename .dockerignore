# The build context is only what the Dockerfile copies, so secrets and local
# state (users' files, databases, logs, tool output) never reach the image.
# Everything is left out, the build inputs are let back in, then local state is
# carved back out of them. The last rule that matches a path wins.
*
!backend/
!frontend/
!pyproject.toml
!uv.lock
!.python-version
!docker-entrypoint.sh

# Secrets — backend/.env holds real API keys and must never be baked in.
**/.env
**/.env.*
!**/.env.example
**/.claude/
**/*.pem
**/*.key

# Users' files: in a development checkout, uploads and agent artifacts land in
# backend/workspace (AGENT_WORKSPACE_DIR).
backend/workspace/

# Local state and build output
**/*.sqlite
**/*.sqlite3
**/*.sqlite3-*
**/*.db
**/*.log
backend/logs/
**/__pycache__/
**/*.py[cod]
**/.venv/
**/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
**/*.tsbuildinfo
**/.mypy_cache/
**/.pytest_cache/
**/.ruff_cache/
**/.vscode/
**/.idea/

# Not needed at run time
backend/tests/
