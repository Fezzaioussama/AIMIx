# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored and must never be committed.

# --- Django ---
# Which settings module to load: config.settings.local | config.settings.production
# manage.py defaults to config.settings.local; wsgi/asgi default to production.
DJANGO_SETTINGS_MODULE=config.settings.local
# Generate a fresh key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Required in production — the app refuses to start without it.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
DJANGO_LOG_LEVEL=INFO
# SQLite filename, relative to backend/
DJANGO_DB_NAME=db.sqlite3

# --- Auth tokens ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=1

# --- LLM provider ---
# Supported values: openrouter, togetherai
LLM_PROVIDER=openrouter
# Every outbound provider call is bounded by this timeout (seconds). One hour, so
# long generations finish; the frontend waits as long (GENERATION_TIMEOUT_MS).
LLM_TIMEOUT_SECONDS=3600
# How many steps of one parallel pipeline stage may call the provider at once.
PIPELINE_MAX_PARALLEL_STEPS=4

# OpenRouter
OPEN_ROUTER_KEY=your_api_key_here
# Override only to point at a proxy or a compatible gateway.
OPENROUTER_BASE_URL=
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-v4-flash

# TogetherAI
TOGAI_API_KEY=your_api_key_here
TOGETHERAI_BASE_URL=
TOGETHERAI_DEFAULT_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8
