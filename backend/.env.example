# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored and must never be committed.

# --- Django ---
# Generate a fresh key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- LLM provider ---
# Supported values: openrouter, togai
LLM_PROVIDER=openrouter
OPEN_ROUTER_KEY=your_api_key_here
TOGAI_API_KEY=your_api_key_here

# --- n8n engine ---
N8N_BASE_URL=http://localhost:5678
N8N_PUBLIC_URL=http://localhost:5678
N8N_API_KEY=your_api_key_here
