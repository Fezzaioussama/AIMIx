# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored and must never be committed.

# --- App ---
# local | production | test. production refuses to start with DEBUG on, a
# missing, short (under 32 characters) or development SECRET_KEY, no
# ALLOWED_HOSTS, or PASSWORD_HASH_ITERATIONS under 600000, and turns off the
# interactive API docs.
APP_ENV=local
# Signs the JWTs and encrypts the API keys users save on the Settings page.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Required in production (at least 32 characters). Left unset elsewhere, a
# public development key is used and the server logs a warning at startup.
# The old DJANGO_* names below are still accepted.
SECRET_KEY=change-me
# Previous SECRET_KEYs, comma-separated, accepted while rotating: sessions they
# signed stay valid and API keys they encrypted stay readable; only SECRET_KEY
# signs and encrypts. To rotate: put the old key here, set the new SECRET_KEY,
# restart. Remove the old key once users have re-saved their API keys and
# integration headers (until then those are read with it). Never list a key that
# leaked: that only rotates in name.
SECRET_KEY_FALLBACKS=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
LOG_LEVEL=INFO
# Built frontend to serve from the API process (the Docker image sets
# /app/frontend/dist). Leave empty locally: the Vite dev server serves the app.
FRONTEND_DIST_DIR=
# How many proxies in front of the app append to X-Forwarded-For; it decides the
# client address the sign-in rate limit counts. 0 (the default) ignores the
# header and uses the connection's peer: right when nothing sits in front, and
# then never run uvicorn with --forwarded-allow-ips '*', which rewrites the peer
# from the header. With N > 0: no header means the peer; otherwise the entry N
# from the right (a client can prepend entries, never remove the ones proxies
# append), or the leftmost entry when the chain is shorter than N (only trusted
# proxies wrote it). A port on the entry is dropped. Railway: 2.
TRUSTED_PROXY_HOPS=0
# Largest request body other than a file upload (JSON: run inputs carrying
# document text, pipelines, chat), in bytes. Uploads (multipart) are capped at
# DOCUMENT_MAX_BYTES plus 1 MB. Both are counted as the body arrives, so a body
# sent without a Content-Length is refused too (413 request_too_large).
REQUEST_MAX_JSON_BYTES=5000000
# SQLAlchemy URL; leave unset for backend/aimix.sqlite3. Apply migrations with
# `make migrate`. Example for Postgres (needs a driver such as psycopg):
# DATABASE_URL=postgresql+psycopg://aimix:secret@localhost/aimix

# --- Auth tokens ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=1
# HttpOnly cookie name used for rotating refresh tokens.
REFRESH_COOKIE_NAME=aimix_refresh
# PBKDF2 work factor for password hashes (Django's default, so hashes match);
# production requires at least 600000. A sign-in re-hashes a password stored at
# another work factor (such as one imported from Django) at this one.
PASSWORD_HASH_ITERATIONS=1000000
# Public sign-up spends deployment resources: off by default. For local
# development create an account with `make create-user USERNAME=you`, or set
# this True. Keep it off in production unless sign-up is intentionally open.
ALLOW_PUBLIC_REGISTRATION=False
# Per client (see TRUSTED_PROXY_HOPS) and auth operation; persisted so multiple
# app processes agree.
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Failed sign-ins one username may take per window, whatever the client: past
# it, sign-in for that username is refused (429) until the window ends, even
# with the right password. A successful sign-in clears the count. Anyone can
# lock a username this way for one window, the price of stopping guessing
# spread over many addresses.
AUTH_ACCOUNT_FAILURE_LIMIT=10
AUTH_ACCOUNT_FAILURE_WINDOW_SECONDS=900
# Per account and route, for requests that make the server spend (model calls,
# outbound calls such as testing an integration, document parsing). Persisted too.
USER_RATE_LIMIT_REQUESTS=30
USER_RATE_LIMIT_WINDOW_SECONDS=60

# --- LLM provider ---
# Server-wide defaults. Each user sets the provider, their own API key and the
# default model on the Settings page; without a saved key their requests fail
# with provider_not_configured. The provider and model fall back here.
# Supported values: openrouter, togetherai
LLM_PROVIDER=openrouter
# Whether an account with no saved key may spend the OPEN_ROUTER_KEY / TOGAI_API_KEY
# below. False (the default): they are never used for accounts, so a key left in
# this file does not let anyone who signs in use the app for free. Set True only
# for a private instance whose every user you trust to spend that key. The
# llm-probe command always uses them.
ALLOW_SERVER_LLM_KEY=False
# Every outbound provider call is bounded by this timeout (seconds). One hour, so
# long generations finish; the frontend waits as long (GENERATION_TIMEOUT_MS).
LLM_TIMEOUT_SECONDS=3600
# Model calls that fail transiently (a dropped connection, HTTP 408, 429, 500,
# 502, 503 or 504) are retried up to LLM_MAX_RETRIES times; 0 turns retries off
# (at most 10). A retry waits the provider's Retry-After if it sent one, else a
# random time between 0 and LLM_RETRY_BASE_DELAY_SECONDS * 2^n for the nth
# retry (n from 0), and never longer than LLM_RETRY_MAX_DELAY_SECONDS. Timeouts
# are not retried, a stream only before its first text, and MCP or built-in
# tool calls never.
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=1
LLM_RETRY_MAX_DELAY_SECONDS=20
# How many steps of one parallel pipeline stage may call the provider at once.
PIPELINE_MAX_PARALLEL_STEPS=4
# Pipeline runs execute in the background of the API process. At most this many
# run at once; the rest wait, queued. A restart interrupts active runs (they can
# be resumed); on shutdown they get this long to record that (seconds).
RUN_MAX_CONCURRENT=4
RUN_SHUTDOWN_GRACE_SECONDS=5
# Every run records the tokens its model calls used and, where it can be known,
# what they cost (OpenRouter reports it; TogetherAI is priced from the catalogue;
# a model with no known price counts tokens only). A run stops, failed with
# "budget_exceeded", once its calls have cost this much, in US dollars. This is
# the limit of a run whose starter sets none; whoever starts a run can set their
# own, and raise it to resume a run that stopped. Empty means no limit. A call in
# flight when the limit is reached still finishes and counts.
RUN_DEFAULT_MAX_COST_USD=
# Scheduled runs (Pipeline > Schedule). The scheduler runs inside the API process:
# it looks for due schedules every SCHEDULER_TICK_SECONDS, so a run starts at most
# that late. Run one process only; SCHEDULER_ENABLED=false keeps schedules saved
# but starts none. SCHEDULES_MAX_PER_USER limits how many schedules one account has.
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30
SCHEDULES_MAX_PER_USER=20

# OpenRouter
OPEN_ROUTER_KEY=your_api_key_here
# Override only to point at a proxy or a compatible gateway.
OPENROUTER_BASE_URL=
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-v4-flash

# TogetherAI
TOGAI_API_KEY=your_api_key_here
TOGETHERAI_BASE_URL=
TOGETHERAI_DEFAULT_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8

# --- LangGraph chat agent ---
# The agent uses the selected LLM_PROVIDER and its default model. Choose a model
# that supports tool calling for native and MCP tools to be usable.
AGENT_TIMEOUT_SECONDS=3600
AGENT_RECURSION_LIMIT=25
AGENT_TOOL_DESCRIPTION_MAX_CHARS=300
# Bounds MCP discovery and each tool call (seconds). No automatic retries.
MCP_TIMEOUT_SECONDS=30
# One HTTP response from a user's MCP server (a JSON answer or an event stream)
# is cut off past this many bytes, so a server cannot fill the memory.
MCP_MAX_RESPONSE_BYTES=10000000
# The text of one MCP tool result (any server) is cut here before the model
# reads it (characters).
MCP_TOOL_RESULT_MAX_CHARS=50000
# JSON object of trusted MCP servers. All tools from every listed server are
# available to the authenticated chat agent. Empty means no MCP tools; native
# pipeline tools remain available.
# Example: {"docs":{"transport":"streamable_http","url":"https://docs.langchain.com/mcp"}}
MCP_SERVERS={}
# Each user can also connect their own MCP servers on the Settings page
# (Integrations). Those use streamable HTTP over https only and must resolve to
# public addresses; their header values are encrypted with SECRET_KEY. This
# caps how many each user may add.
INTEGRATIONS_MAX_PER_USER=10
# Local development only: let integrations reach loopback and private
# addresses (e.g. an MCP server on 127.0.0.1). Honoured only with
# APP_ENV=local; production refuses to start with it on.
INTEGRATIONS_ALLOW_PRIVATE_NETWORK=False

# --- Approval gates: agents ask before acting on outside systems ---
# In a pipeline run, a call of a tool that can change something outside AIMIx
# waits for the run's owner to approve it (the run shows "Waiting for you").
# The tools of MCP_SERVERS ask first unless this is False. Chat has no run to
# pause, so it is not offered tools that ask: set False to keep MCP_SERVERS tools
# in chat (they then act without asking, in runs too).
MCP_REQUIRE_APPROVAL=True
# Each user's integrations have their own "Ask me before its tools act" switch
# (on by default). Built-in tools ask first only when listed here, comma-separated
# (for example save_artifact,run_python); empty means none.
AGENT_APPROVAL_TOOLS=
# A request nobody answers expires after this long and counts as declined
# (seconds). It never waits longer than AGENT_TIMEOUT_SECONDS, which the wait
# counts toward.
APPROVAL_TIMEOUT_SECONDS=1800
# How often a waiting run reads the database for the answer (seconds).
APPROVAL_POLL_SECONDS=1
# How much of a call's arguments the owner can read before long text is cut
# (characters). The arguments are never written to the logs.
APPROVAL_ARGUMENTS_MAX_CHARS=4000

# --- Built-in agent tools ---
# Comma-separated tools offered to pipeline and chat agents (unknown names are
# ignored; empty offers none). Local workspace tools are confined to
# AGENT_WORKSPACE_DIR, reject hidden paths, and never overwrite artifacts.
AGENT_BUILTIN_TOOLS=web_search,fetch_url,calculator,current_datetime,list_workspace_files,read_workspace_file,search_workspace_files,read_csv,save_artifact,run_python
# By default, enabling workspace readers disables outbound web tools so an agent
# cannot disclose local data in a search query or URL. This opt-in weakens that
# boundary and should be used only with non-confidential workspaces.
AGENT_ALLOW_WORKSPACE_NETWORK_ACCESS=False
# Applies to every web search and page fetch request (seconds). No retries.
WEB_TIMEOUT_SECONDS=15
# Bounds one whole fetch_url call, every redirect and the download included (seconds).
WEB_FETCH_MAX_SECONDS=30
# A page download stops at this many bytes, counted after decompression; the
# agent sees at most MAX_CHARS.
WEB_FETCH_MAX_BYTES=2000000
WEB_FETCH_MAX_CHARS=20000
WEB_SEARCH_MAX_RESULTS=5
# web_search uses Tavily (https://tavily.com, free tier available). Without a
# key the tool is simply not offered.
TAVILY_API_KEY=your_api_key_here
TAVILY_SEARCH_URL=https://api.tavily.com/search

# Local files available to agents. Relative paths are resolved from backend/.
# Each account gets its own folder in it (user-<id>), which is also what the
# Files page shows; keep it on persistent storage (the image uses /data/workspace).
AGENT_WORKSPACE_DIR=workspace
# Largest file an agent reads or saves (bytes).
WORKSPACE_MAX_FILE_BYTES=2000000
WORKSPACE_MAX_OUTPUT_CHARS=20000
WORKSPACE_SEARCH_MAX_FILES=200
WORKSPACE_SEARCH_MAX_RESULTS=50
WORKSPACE_CSV_MAX_ROWS=200
# Everything one account may keep, uploads and agent artifacts together (bytes).
WORKSPACE_MAX_TOTAL_BYTES=100000000
# Files and folders one account may keep, however small (each costs an inode on
# the volume, and every save walks them all to count the quota).
WORKSPACE_MAX_FILES=2000
# File types the Files page accepts; each upload is capped at DOCUMENT_MAX_BYTES.
WORKSPACE_UPLOAD_EXTENSIONS=.pdf,.docx,.xlsx,.pptx,.txt,.md,.csv,.json,.yaml,.yml,.html
# TrueType fonts for the PDFs agents save (the image installs fonts-dejavu-core).
# Without them a PDF falls back to a built-in font that prints Western European
# text only; other scripts show as boxes.
PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
PDF_BOLD_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# run_python runs agent-written Python in a fresh E2B cloud sandbox (e2b.dev)
# that has no internet access and is destroyed after every call; nothing runs
# in this process. Without a key the tool is simply not offered. The key is
# server-wide: every user who can run agents spends it. E2B receives the code
# and the workspace files the agent names in input_files. Once offered,
# run_python reads the workspace, so like the reader tools it removes web_search
# and fetch_url unless AGENT_ALLOW_WORKSPACE_NETWORK_ACCESS=True.
E2B_API_KEY=your_api_key_here
# Bounds each call, from creating its sandbox to collecting the files the code
# wrote, and the sandbox's own lifetime (seconds).
SANDBOX_TIMEOUT_SECONDS=60
# The report returned to the agent (error, files, result, stdout, stderr) is cut here.
SANDBOX_MAX_OUTPUT_CHARS=10000
# Input files uploaded, and output files or charts saved, per call. Both obey
# WORKSPACE_MAX_FILE_BYTES; saved files go to sandbox/<UTC time>/ in the workspace.
SANDBOX_MAX_FILES=10
# A call that streams back more than this (stdout, stderr and displayed results
# such as charts) is stopped, so a runaway print loop cannot exhaust memory.
SANDBOX_MAX_STREAM_CHARS=5000000
# run_python calls one account may make per hour (chat and runs together); past
# it the agent is told to try later. Each call spends E2B_API_KEY.
SANDBOX_MAX_CALLS_PER_HOUR=120

# --- Documents attached to a pipeline run ---
# PDF, Word (.docx), Excel (.xlsx), PowerPoint (.pptx), images (png, jpg, jpeg,
# webp, tif, tiff, bmp, gif), HTML and plain-text files (txt, md, csv, tsv, json,
# yaml, xml, log, rst) are turned into text server-side; the text becomes a run input.
# Largest upload accepted (bytes): a run document or a file on the Files page.
DOCUMENT_MAX_BYTES=10000000
# Text kept from one document; the remainder is dropped and the run is told.
DOCUMENT_MAX_CHARS=120000
# PDF pages, PowerPoint slides or TIFF pages read before stopping.
DOCUMENT_MAX_PAGES=300
# .docx, .xlsx and .pptx files are zip archives: refuse one that would unpack to
# more than this (bytes).
DOCUMENT_MAX_UNPACKED_BYTES=50000000
# ...or that holds a part over this that is not a picture or other media (bytes):
# parsing XML costs many times its size in time and memory. A workbook sheet this
# large has tens of thousands of rows, past what DOCUMENT_MAX_SPREADSHEET_ROWS reads.
DOCUMENT_MAX_XML_PART_BYTES=10000000
# Documents read at once in the process, uploads and agents alike. Another one
# waits up to DOCUMENT_EXTRACTION_WAIT_SECONDS for its turn, then is refused with
# 503 documents_busy; a scanned PDF page waits as long for the PDF renderer
# (one page at a time), then is skipped.
DOCUMENT_MAX_CONCURRENT_EXTRACTIONS=2
DOCUMENT_EXTRACTION_WAIT_SECONDS=30
# Spreadsheet rows read from one workbook, across all its sheets (blank rows count).
# Reading also stops once more cells were read than DOCUMENT_MAX_CHARS.
DOCUMENT_MAX_SPREADSHEET_ROWS=5000
# An image with more pixels is refused before it is decoded; a PDF page rendered
# for OCR is scaled down to fit.
DOCUMENT_MAX_IMAGE_PIXELS=40000000

# OCR (text recognition) reads images and PDF pages that have no text layer, with
# the tesseract binary (the Docker image includes it, with English and French).
# Off, or without the binary or a listed language, such pages are skipped and the
# text says so; an image is refused. The reason is logged once, at startup.
DOCUMENT_OCR_ENABLED=True
# Tesseract language codes joined by "+"; each needs its tesseract-ocr-<code> package.
DOCUMENT_OCR_LANGUAGES=eng+fra
# Pages one document may send to OCR; later scanned pages are skipped and named.
DOCUMENT_OCR_MAX_PAGES=30
# All the OCR of one document (seconds): no page starts after this, and later
# scanned pages are skipped and named.
DOCUMENT_OCR_MAX_SECONDS=120
# Per page (seconds): a page that takes longer is skipped. No retries. A document
# can therefore spend up to DOCUMENT_OCR_MAX_SECONDS plus this in OCR.
DOCUMENT_OCR_TIMEOUT_SECONDS=15
# Resolution a PDF page is rendered at for OCR (300 suits Tesseract).
DOCUMENT_OCR_DPI=300
