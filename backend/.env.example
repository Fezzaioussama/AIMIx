# Copy this file to backend/.env and fill in real values.
# backend/.env is git-ignored and must never be committed.

# --- App ---
# local | production | test. production refuses to start with DEBUG on, no
# SECRET_KEY, or no ALLOWED_HOSTS, and turns off the interactive API docs.
APP_ENV=local
# Signs the JWTs and encrypts the API keys users save on the Settings page —
# changing it means those keys must be entered again. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# Required in production. The old DJANGO_* names below are still accepted.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
LOG_LEVEL=INFO
# Built frontend to serve from the API process (the Docker image sets
# /app/frontend/dist). Leave empty locally: the Vite dev server serves the app.
FRONTEND_DIST_DIR=
# SQLAlchemy URL; leave unset for backend/aimix.sqlite3. Apply migrations with
# `make migrate`. Example for Postgres (needs a driver such as psycopg):
# DATABASE_URL=postgresql+psycopg://aimix:secret@localhost/aimix

# --- Auth tokens ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=1
# HttpOnly cookie name used for rotating refresh tokens.
REFRESH_COOKIE_NAME=aimix_refresh
# PBKDF2 work factor for new password hashes (Django's default, so hashes match).
PASSWORD_HASH_ITERATIONS=1000000
# Public sign-up spends deployment resources and may use the server-wide LLM
# key. Keep it off in production unless account creation is intentionally open.
ALLOW_PUBLIC_REGISTRATION=True
# Per client and auth operation; persisted so multiple app processes agree.
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- LLM provider ---
# Server-wide defaults. Each user can override the provider, API keys and
# default model on the Settings page; whatever they leave unset falls back here.
# Supported values: openrouter, togetherai
LLM_PROVIDER=openrouter
# Every outbound provider call is bounded by this timeout (seconds). One hour, so
# long generations finish; the frontend waits as long (GENERATION_TIMEOUT_MS).
LLM_TIMEOUT_SECONDS=3600
# How many steps of one parallel pipeline stage may call the provider at once.
PIPELINE_MAX_PARALLEL_STEPS=4

# OpenRouter
OPEN_ROUTER_KEY=your_api_key_here
# Override only to point at a proxy or a compatible gateway.
OPENROUTER_BASE_URL=
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-v4-flash

# TogetherAI
TOGAI_API_KEY=your_api_key_here
TOGETHERAI_BASE_URL=
TOGETHERAI_DEFAULT_MODEL=meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8

# --- LangGraph chat agent ---
# The agent uses the selected LLM_PROVIDER and its default model. Choose a model
# that supports tool calling for native and MCP tools to be usable.
AGENT_TIMEOUT_SECONDS=3600
AGENT_RECURSION_LIMIT=25
AGENT_TOOL_DESCRIPTION_MAX_CHARS=300
# Bounds MCP discovery and each tool call (seconds). No automatic retries.
MCP_TIMEOUT_SECONDS=30
# JSON object of trusted MCP servers. All tools from every listed server are
# available to the authenticated chat agent. Empty means no MCP tools; native
# pipeline tools remain available.
# Example: {"docs":{"transport":"streamable_http","url":"https://docs.langchain.com/mcp"}}
MCP_SERVERS={}

# --- Built-in agent tools ---
# Comma-separated tools offered to pipeline and chat agents (unknown names are
# ignored; empty offers none). Local workspace tools are confined to
# AGENT_WORKSPACE_DIR, reject hidden paths, and never overwrite artifacts.
AGENT_BUILTIN_TOOLS=web_search,fetch_url,calculator,current_datetime,list_workspace_files,read_workspace_file,search_workspace_files,read_csv,save_artifact
# By default, enabling workspace readers disables outbound web tools so an agent
# cannot disclose local data in a search query or URL. This opt-in weakens that
# boundary and should be used only with non-confidential workspaces.
AGENT_ALLOW_WORKSPACE_NETWORK_ACCESS=False
# Applies to every web search and page fetch request (seconds). No retries.
WEB_TIMEOUT_SECONDS=15
# A page download stops at this many bytes; the agent sees at most MAX_CHARS.
WEB_FETCH_MAX_BYTES=2000000
WEB_FETCH_MAX_CHARS=20000
WEB_SEARCH_MAX_RESULTS=5
# web_search uses Tavily (https://tavily.com, free tier available). Without a
# key the tool is simply not offered.
TAVILY_API_KEY=your_api_key_here
TAVILY_SEARCH_URL=https://api.tavily.com/search

# Local files available to agents. Relative paths are resolved from backend/.
AGENT_WORKSPACE_DIR=workspace
WORKSPACE_MAX_FILE_BYTES=2000000
WORKSPACE_MAX_OUTPUT_CHARS=20000
WORKSPACE_SEARCH_MAX_FILES=200
WORKSPACE_SEARCH_MAX_RESULTS=50
WORKSPACE_CSV_MAX_ROWS=200

# --- Documents attached to a pipeline run ---
# PDF, Word (.docx), Excel (.xlsx), PowerPoint (.pptx), images (png, jpg, jpeg,
# webp, tif, tiff, bmp, gif), HTML and plain-text files (txt, md, csv, tsv, json,
# yaml, xml, log, rst) are turned into text server-side; the text becomes a run input.
# Largest upload accepted (bytes).
DOCUMENT_MAX_BYTES=10000000
# Text kept from one document; the remainder is dropped and the run is told.
DOCUMENT_MAX_CHARS=120000
# PDF pages, PowerPoint slides or TIFF pages read before stopping.
DOCUMENT_MAX_PAGES=300
# .docx, .xlsx and .pptx files are zip archives: refuse one that would unpack to
# more than this (bytes).
DOCUMENT_MAX_UNPACKED_BYTES=50000000
# Spreadsheet rows read from one workbook, across all its sheets (blank rows count).
# Reading also stops once more cells were read than DOCUMENT_MAX_CHARS.
DOCUMENT_MAX_SPREADSHEET_ROWS=5000
# An image with more pixels is refused before it is decoded; a PDF page rendered
# for OCR is scaled down to fit.
DOCUMENT_MAX_IMAGE_PIXELS=40000000

# OCR (text recognition) reads images and PDF pages that have no text layer, with
# the tesseract binary (the Docker image includes it, with English and French).
# Off, or without the binary or a listed language, such pages are skipped and the
# text says so; an image is refused. The reason is logged once, at startup.
DOCUMENT_OCR_ENABLED=True
# Tesseract language codes joined by "+"; each needs its tesseract-ocr-<code> package.
DOCUMENT_OCR_LANGUAGES=eng+fra
# Pages one document may send to OCR; later scanned pages are skipped and named.
DOCUMENT_OCR_MAX_PAGES=30
# Per page (seconds): a page that takes longer is skipped. No retries. A document
# can therefore spend up to DOCUMENT_OCR_MAX_PAGES x this in OCR.
DOCUMENT_OCR_TIMEOUT_SECONDS=15
# Resolution a PDF page is rendered at for OCR (300 suits Tesseract).
DOCUMENT_OCR_DPI=300
