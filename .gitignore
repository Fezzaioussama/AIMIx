# ─────────────────────────────────────────────────────────────────────────────
# Editing rule: a pattern WITHOUT a leading slash matches at every depth. That
# is how an entry like `lib/` ends up silently hiding frontend/src/lib/. So:
#   • anchor anything naming a build, cache, env or output directory  -> /dist/
#   • leave unanchored only what legitimately appears at any depth
#     (__pycache__/, node_modules/, editor and OS droppings)
# Verify a change with:  git check-ignore -v <path>
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets and local configuration ──────────────────────────────────────────
.env
.claude
.env.*
!.env.example
!.env.*.example
.envrc
.direnv/
local_settings.py
settings.local.py
# Per-developer overrides, e.g. .claude/settings.local.json. A shared
# .claude/settings.json stays tracked on purpose.
*.local
*.local.*

# Key material and credential dumps. Deliberately broad: a mis-ignored source
# file is a nuisance, a committed private key is an incident.
*.pem
*.key
*.crt
*.cer
*.cert
*.csr
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
secrets.*
*.secret
*.secrets
credentials.*
*.credentials
*.credentials.*
*.token
*.tokens
*.auth
*.passwd
*.password

# ── Databases and runtime state ──────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.sqlite3-*
*.pid
*.pid.lock

# ── Logs, coverage and reports ───────────────────────────────────────────────
*.log
/logs/
/backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.coverage
.coverage.*
/coverage/
/frontend/coverage/
/htmlcov/
*.lcov

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
# Packaging output (anchored: `build/` and `dist/` unanchored would hide source
# folders of the same name).
/build/
/dist/
/sdist/
/downloads/
/*.egg-info/
*.egg
MANIFEST
# Tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
# Compiled translations — the .po sources stay tracked.
*.mo

# ── Virtual environments (repo root only) ────────────────────────────────────
/.venv/
/venv/
/env/
/ENV/
/venv.bak/
/env.bak/

# ── Node / Vite ──────────────────────────────────────────────────────────────
node_modules/
/frontend/dist/
/frontend/.vite/
*.tsbuildinfo
.npm/
.eslintcache

# ── Editors, OS and merge artifacts ──────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*Zone.Identifier
.vscode/
.idea/
.history/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*~
*.bak
*.orig
*.rej

# ── AI assistant local state ─────────────────────────────────────────────────
# Tracked on purpose: AGENTS.md, CLAUDE.md, and any .cursor/ or .github/
# pointer files — they are shared rules, not local state.
.codex/
.agents/
.agents-server/

# ── Local notes ──────────────────────────────────────────────────────────────
doc_understanding.md
